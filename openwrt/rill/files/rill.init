#!/bin/sh /etc/rc.common
# procd init script for rill.
# Service settings live in /etc/config/rill (UCI); the proxy configuration
# itself is the regular rill YAML file (default /etc/rill/config.yaml).

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/rill
GATEWAY=/usr/share/rill/gateway.sh

start_service() {
	local enabled config_file work_dir panel_port secret tproxy controller

	config_load rill
	config_get_bool enabled main enabled 0
	config_get config_file main config_file /etc/rill/config.yaml
	config_get work_dir main work_dir /etc/rill
	config_get panel_port main panel_port 9090
	config_get secret main secret ''
	config_get_bool tproxy tproxy enabled 0

	[ "$enabled" -eq 1 ] || return 0
    [ "$config_file" = /etc/rill/config.yaml ] && [ "$work_dir" = /etc/rill ] || {
        logger -t rill 'managed service requires /etc/rill/config.yaml and work_dir /etc/rill'
        return 1
    }

	if ! "$PROG" --no-external-plugins --offline -d "$work_dir" -f "$config_file" -t >/dev/null 2>&1; then
		logger -t rill "config test failed for $config_file, not starting"
		return 1
	fi

	controller="127.0.0.1:$panel_port"
	[ -z "$secret" ] || controller="0.0.0.0:$panel_port"
	procd_open_instance rill
	procd_set_param command "$PROG" --no-external-plugins -d "$work_dir" -f "$config_file" \
		--ext-ctl "$controller"
	[ -n "$secret" ] && procd_append_param command --secret "$secret"
	# Restart when either the UCI service settings or the YAML config change.
	procd_set_param file /etc/config/rill "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1000000 1000000"
	procd_close_instance

	if [ "$tproxy" -eq 1 ]; then
        # A supervised instance owns the wait and rules, including teardown.
        procd_open_instance gateway
        procd_set_param command "$GATEWAY" run
        procd_set_param term_timeout 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
	else
		"$GATEWAY" down
	fi
}

stop_service() {
	"$GATEWAY" down
}

service_triggers() {
	procd_add_reload_trigger "rill"
}

reload_service() {
	stop
	start
}
