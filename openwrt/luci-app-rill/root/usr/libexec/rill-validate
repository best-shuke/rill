#!/bin/sh
# No caller-supplied CLI flags or paths: only the generated scratch token.
set -eu
[ "$#" -eq 1 ] || exit 1
case "$1" in
    check) scratch=/tmp/rill-luci-check.yaml ;;
    *)
        [ "${#1}" -eq 32 ] || exit 1
        case "$1" in *[!0-9a-f]*) exit 1 ;; esac
        scratch="/tmp/rill-luci-settings-$1.yaml"
        ;;
esac
# Delegated LuCI configuration is deliberately confined to /etc/rill.
exec /usr/bin/rill --no-external-plugins --offline -d /etc/rill -f "$scratch" -t
